# Copy to .env and fill in the blanks.
#
# --- Running via docker-compose (default) ---
# Services reach each other by their compose service name:
POSTGRES_CONN_STRING=postgres://tender:tender@postgres:5432/tender?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
#
# --- Running the Go binary directly on your host ---
# (postgres + rabbitmq still started via `docker compose up postgres rabbitmq`)
# POSTGRES_CONN_STRING=postgres://tender:tender@localhost:5432/tender?sslmode=disable
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# AWS S3 (doc-download worker checks/stores tender folders here).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=tenderbharat-ap-south-1

# S3 endpoint override for LocalStack. Leave EMPTY to use real AWS.
AWS_ENDPOINT_URL=http://localstack:4566

# Logging: LOG_FORMAT=text|json, LOG_LEVEL=debug|info|warn|error.
# Use json in production so logs ship cleanly into Loki/ELK/CloudWatch/Datadog.
LOG_FORMAT=text
LOG_LEVEL=info

# Captcha mode: "manual" = type it by hand on stdin; empty = automated OCR solver.
CAPTCHA_MODE=manual
# Directory for manual captcha images (mount to host for easy viewing).
CAPTCHA_DIR=TenderData/captchas
# 2captcha key for captcha-protected portals (only for the automated solver).
APIKEY_2CAPTCHA=
